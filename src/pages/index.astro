---
import Navbar from "../components/Navbar";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<Navbar client:load />
	<main class="min-h-screen bg-white text-[#111827]">
		<!-- Hero -->
		<section
			class="mx-auto max-w-7xl px-5 pb-16 pt-20 text-center sm:px-8 sm:pb-24
sm:pt-28"
		>
			<p
				class="mb-5 text-sm font-semibold uppercase tracking-[0.2em]
text-[#111827]/60"
			>
				Simple tools. Better writing.
			</p>
			<h1
				class="mx-auto
max-w-4xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl
lg:text-7xl"
			>
