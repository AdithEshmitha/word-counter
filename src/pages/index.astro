-->
		<section id="faq" class="mx-auto max-w-4xl px-5 py-20 sm:px-8 sm:py-24">
			<div class="text-center">
				<p
					class="text-sm font-semibold uppercase
tracking-[0.16em] text-[#111827]/55"
				>
					Frequently asked questions
