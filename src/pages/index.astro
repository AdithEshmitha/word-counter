								0
							</p>
						</div>
						<div class="rounded-xl border border-[#111827]/15 p-4">
							<p class="text-sm
text-[#111827]/60">Characters</p>
							<p
								id="character-count"
								class="mt-2 text-3xl
font-bold"
							>
								0
							</p>
						</div>
						<div class="rounded-xl border border-[#111827]/15 p-4">
							<p class="text-sm text-[#111827]/60">
