								>
							</li>
							<li>
								<a
									href="/slug-generator/"
									class="transition-colors
hover:text-white"
									>Slug Generator</a
								>
							</li>
						</ul>
					</div>
					<div>
						<h2
							class="text-sm
font-semibold uppercase tracking-wider"
						>
							Wordix
						</h2>
						<ul class="mt-4 space-y-3
text-sm text-white/70">
							<li>
								<a
									href="/"
									class="transition-colors
hover:text-white"
									>Home</a
								>
							</li>
							<li>
								<a
									href="#tools"
									class="transition-colors
hover:text-white"
